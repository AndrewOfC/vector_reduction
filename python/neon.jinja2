

    while( len > 0 ) {
        {%- for i in range(n) %}
        {{p.VTYPE}} r{{"%03d" | format(i)}} = {{ p.LOAD }}(&src[{{i*2}}]);
        {%- endfor %}

        {%- for j in steps %}
        {% for i in range(j) %}
        r{{"%03d" | format(i)}} = {{ p.ADD }}(r{{"%03d" | format(i)}}, r{{"%03d" | format(i+j)}});
        {%- endfor %}
        {%- endfor %}

        {{ p.DTYPE }} result[2] ;
        {{ p.EXTRACT }}(&result[0], r000);
        initial += (result[0] + result[1]) ;
        len -= {{ p.step }} ;
        src += {{ p.step }} ;
    }


    return initial ;