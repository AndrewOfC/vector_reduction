{%- for n in steps %}
    /*
     * 
     */
    while( len >= {{ n }} * {{ p.STRIDE }} ) {
        {%- for i in range(n) %}
        {{ p.VTYPE }} r{{"%03d" | format(i)}} = {{ p.LOAD }}(src+{{ i*p.STRIDE }});
        {%- endfor %}

        {%- for j in steps[loop.index:] %}
        {% for i in range(j) %}
        r{{"%03d" | format(i)}} = {{ p.ADD }}(r{{"%03d" | format(i)}}, r{{"%03d" | format(i+j)}});
        {%- endfor %}
        {%- endfor %}

        initial += {{ p.REDUCE }}(r000) ;
        len -= {{ n }} * {{ p.STRIDE }} ;
        src += {{ n }} * {{ p.STRIDE }}  ;
    } // while
{%- endfor %}

    // clean up on aisle 3
    for( size_t i = 0 ; i < len ; i++, src++ ) {
        initial += *src ;
    }

    return initial ;