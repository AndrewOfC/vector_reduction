{%- for n in steps %}
    /*
     * 
     */
    while( len >= {{ n*8 }} ) {
        {%- for i in range(n) %}
        __m512d r{{"%03d" | format(i)}} = _mm512_loadu_pd(src+{{i*8}});
        {%- endfor %}

        {%- for j in steps[loop.index:] %}
        {% for i in range(j) %}
        r{{"%03d" | format(i)}} = _mm512_add_pd(r{{"%03d" | format(i)}}, r{{"%03d" | format(i+j)}});
        {%- endfor %}
        {%- endfor %}

        initial += _mm512_reduce_add_pd(r000) ;
        len -= {{ n*8 }} ;
        src += {{ n*8 }}  ;
    } // while
{%- endfor %}

    // clean up on aisle 3
    for( size_t i = 0 ; i < len ; i++, src++ ) {
        initial += *src ;
    }

    return initial ;